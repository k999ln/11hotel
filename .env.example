# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # 必須: waitlist/admin APIで使用。Supabase > Settings > API > service_role

# 管理画面
ADMIN_TOKEN=your-admin-token
ADMIN_SECRET=your-admin-secret   # Worker の X-Admin-Secret と一致させる
API_BASE=https://your-worker.workers.dev

# Quant Control Center (/ai) — trading-bot の run_admin_bridge.py と共有
# wrangler secret put AI_BRIDGE_TOKEN で本番へ設定する（32文字以上）
AI_BRIDGE_TOKEN=replace-with-long-random-token

# Instagram
IG_ACCESS_TOKEN=IGAA...

# Worker secrets（参照用）
SYNC_SECRET=your-sync-secret

# Google Analytics（任意）
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# AI詳細データ生成（任意）
# ホテル・レストラン追加時に tagline / overview / details を自動生成する。
# 未設定の場合はスキップ（手動入力が必要になる）。
ANTHROPIC_API_KEY=sk-ant-...

# Slack通知（任意）
# 「静かな興味シグナル」（/api/private-signal）の検知をSlackへ通知する場合に設定する。
# 未設定の場合は通知をスキップする（記録自体は行われる）。個人情報・専用URLは通知に含めない。
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxx/xxxx/xxxx

# OpenSea 宿泊券(THE KEY)連携（/stay）— サーバー専用。ブラウザには絶対に露出させない。
# OPENSEA_API_KEY 未設定でもビルド/ページは動作するが、出品データは同期されない（0件表示）。
# 取得: https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=your-opensea-api-key
# THE KEY購入サポートの成約手数料（basis points）。500 = 5%。OpenSea直接購入には加算されない。
KEY_SUPPORT_FEE_BPS=500
# 原子的な仕入れ・購入者移転・利益送金を行うEthereumメインネット上の決済コントラクト。
KEY_CHECKOUT_CONTRACT=0x-your-deployed-checkout-contract
# KEY_CHECKOUT_CONTRACTがV2（1泊あたり最低販売価格つき、contracts/ElevenHotelCheckoutV2.sol）の場合のみ設定する。
# 値は/admin/checkout-deployでV2を公開した時に入力したETH建ての下限と完全に一致させること（例: 0.5）。
# 未設定（空）ならKEY_CHECKOUT_CONTRACTはV1として扱われる。
KEY_NIGHTLY_FLOOR_ETH=
# NOT A HOTEL THE KEY ERC-721（通常は変更不要）。
KEY_COLLECTION_CONTRACT=0xf3f8257fbcfdeff9354b6a0e1a948f7a5ff135a2
# 対象コレクション slug（既定: the-key-nah）と chain（既定: ethereum）。通常は変更不要。
OPENSEA_COLLECTION_SLUG=the-key-nah
OPENSEA_CHAIN=ethereum
# WalletConnect（/stay/[tokenId] の購入で、ブラウザ拡張型ウォレットが無いモバイル環境向けのQR/ディープリンク接続）。
# https://cloud.reown.com （旧WalletConnect Cloud）でプロジェクトを作成し、Project IDを設定する。
# 秘密鍵ではなく公開識別子なのでブラウザに露出しても問題ない。PUBLIC_ prefixによりクライアントに公開される。
PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-cloud-project-id

# R2（動画配信・任意。/api/admin/video-upload-url で使用）
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET=your-bucket
R2_PUBLIC_URL=https://your-r2-public-domain
