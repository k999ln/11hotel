---
import BaseLayout from '@/layouts/BaseLayout.astro';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Concierge',
    serviceType: 'Luxury Japan stay planning, photo session and partner handoff',
    areaServed: 'Japan',
    provider: {
      '@type': 'Organization',
      name: 'いいhotel',
      url: Astro.url.origin,
    },
    description: 'A quiet introduction to how いいhotel shapes cafe to dinner to hotel routes, photo sessions, cultural experiences and private access for travelers visiting Japan.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.url.origin },
      { '@type': 'ListItem', position: 2, name: 'コンシェルジュ', item: `${Astro.url.origin}/luxury` },
    ],
  },
];
---

<BaseLayout
  title="Concierge for Anniversary Stays, Dining and Private Japan Routes"
  description="A quiet guide for overseas travelers visiting Japan. いいhotel shapes cafe to dinner to hotel routes, photo sessions, cultural experiences and private access, connecting guests with appropriate registered partners and local specialists."
  structuredData={structuredData}
>
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">Concierge</p>
      <h1 class="h1 serif">Plan before.<br />Meet only when it matters.</h1>
      <p class="lead">
        いいhotel helps overseas travelers shape a Japan stay around cafe → dinner → hotel routes, hidden local places, photo sessions and private support. We organize your preferences and connect you with registered travel partners, facilities and local specialists.
      </p>
      <p class="lead-en serif">Plan before. Meet only when it matters. Capture beautifully.</p>
      <div class="hero-actions">
        <a href="https://www.instagram.com/kirin.41/" target="_blank" rel="noopener noreferrer" id="luxuryInquiryLink">Private Inquiry →</a>
        <a href="/discover">Explore Discover</a>
      </div>
    </section>

    <section class="cards">
      {[
        ['Cafe → Dinner → Hotel', 'A full evening route for anniversaries, honeymoons and private Japan stays.'],
        ['Dining Access', 'Hotel restaurants, private dining, bars, cafes and hard-to-book tables through appropriate partners.'],
        ['Photo Sessions', '60–90 min shoots at hotels, gardens and streets. We meet only when the memory matters.'],
        ['Long Stay & Access', 'For extended stays, membership interests and curated access, we collect context and connect you with appropriate partners.'],
      ].map(([title, text]) => (
        <article class="card">
          <h2>{title}</h2>
          <p>{text}</p>
        </article>
      ))}
    </section>

    <section class="process">
      <p class="eyebrow">How it works</p>
      <div class="steps">
        {[
          ['01', 'Tell us your preferences', 'Share travel dates, cities, budget, mood, dining style, hotel taste and support needs.'],
          ['02', 'We shape the route', 'We prepare cafe, dinner, hotel, photo moment, cultural experience and partner handoff candidates.'],
          ['03', 'Partners handle execution', 'Contracts, payments, confirmed reservations, travel services and property matters are handled by registered travel agencies, DMCs, facilities, licensed real estate partners or other appropriate specialists.'],
        ].map(([num, title, text]) => (
          <article class="step">
            <span>{num}</span>
            <h2>{title}</h2>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="notice">
      <h2 class="serif">Important notice</h2>
      <p>
        いいhotel is currently an editorial, lead generation, photo and partner handoff platform. We do not directly sell travel packages, receive travel payments, guarantee reservations, broker real estate, issue accommodation rights, or manage itineraries unless a legally appropriate structure is established. Travel, accommodation, transport, experience, residence and contract matters are handled by each registered partner, licensed business or facility.
      </p>
    </section>

    <section class="conc">
      <p class="conc-q">Curious about a Japan visit shaped this way?</p>
      <p class="conc-p">Share a little about what you're looking for, quietly, via Instagram DM — we'll prepare route, hotel, dining and photo session ideas suited to your taste.</p>
      <a
        href="https://www.instagram.com/kirin.41/" target="_blank" rel="noopener noreferrer"
        class="conc-cta" id="luxuryConciergeInquiry"
      >
        Private Inquiry →
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px 96px; }
  .hero { padding: 80px 0 56px; border-bottom: 1px solid var(--border); }
  .eyebrow { font-size: 10px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 18px; }
  .h1 { font-size: clamp(42px, 7vw, 80px); line-height: 1.04; font-weight: 500; color: var(--ink); margin-bottom: 24px; }
  .lead { max-width: 760px; font-size: 15px; color: var(--ink-2); line-height: 1.9; margin-bottom: 8px; }
  .lead-en { font-size: 18px; font-weight: 400; font-style: italic; color: var(--ink-3); margin-bottom: 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero-actions a { background: var(--ink); color: var(--bg); text-decoration: none; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 12px 20px; }
  .hero-actions a + a { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); margin: 64px 0; }
  @media (max-width: 920px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .cards { grid-template-columns: 1fr; } }
  .card { background: var(--bg); padding: 28px; min-height: 190px; }
  .card h2 { font-size: 16px; color: var(--ink); margin-bottom: 14px; }
  .card p { font-size: 13px; line-height: 1.8; color: var(--ink-2); }
  .process { margin-top: 72px; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 24px; }
  @media (max-width: 760px) { .steps { grid-template-columns: 1fr; } }
  .step { border-top: 1px solid var(--border); padding-top: 20px; }
  .step span { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 36px; color: var(--ink-3); }
  .step h2 { font-size: 17px; margin: 8px 0 10px; color: var(--ink); }
  .step p { font-size: 13px; line-height: 1.8; color: var(--ink-2); }
  .notice { margin-top: 72px; border: 1px solid var(--border); background: var(--white); padding: 32px; }
  .notice h2 { font-size: 28px; font-weight: 500; margin-bottom: 14px; }
  .notice p { font-size: 12px; line-height: 1.9; color: var(--ink-2); }

  /* Concierge inquiry */
  .conc { margin-top: 96px; border-top: 1px solid var(--border); padding-top: 56px; text-align: center; }
  .conc-q { font-size: 16px; font-weight: 600; color: var(--ink); margin: 0 0 10px; }
  .conc-p { font-size: 13px; color: var(--ink-2); line-height: 1.8; max-width: 560px; margin: 0 auto 24px; }
  .conc-cta {
    display: inline-block; padding: 13px 32px;
    background: var(--ink); color: var(--bg); text-decoration: none;
    font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase;
    transition: opacity .15s;
  }
  .conc-cta:hover { opacity: .8; }
</style>
