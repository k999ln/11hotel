---
import { createClient } from '@supabase/supabase-js';

const RL_LIMIT  = 10;
const RL_WINDOW = 10 * 60 * 1000; // 10分
function sanitizeReturnTo(value: string | null): string {
  if (!value) return '/admin';
  if (!value.startsWith('/') || value.startsWith('//')) return '/admin';
  return value;
}

if (Astro.request.method === 'POST') {
  const ip = Astro.request.headers.get('cf-connecting-ip') ?? 'unknown';

  // IP単位のレート制限
  const supabase = createClient(
    import.meta.env.SUPABASE_URL,
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY,
  );
  const since = new Date(Date.now() - RL_WINDOW).toISOString();
  const { count, error: rlErr } = await supabase
    .from('admin_audit_logs')
    .select('*', { count: 'exact', head: true })
    .eq('action', 'rl_admin_login_fail')
    .eq('target', ip)
    .gte('created_at', since);

  // DB障害時は fail-closed（試行をブロック）
  if (rlErr || (count ?? 0) >= RL_LIMIT) {
    return Astro.redirect('/admin/login?error=2');
  }

  const form = await Astro.request.formData();
  const postedReturnTo = sanitizeReturnTo(form.get('return_to')?.toString() ?? null);
  const token = form.get('token')?.toString() ?? '';
  if (token === import.meta.env.ADMIN_TOKEN) {
    Astro.cookies.set('admin_token', token, {
      path: '/',
      httpOnly: true,
      secure: true,
      sameSite: 'strict',
      maxAge: 60 * 60 * 24 * 30,
    });
    return Astro.redirect(postedReturnTo);
  }

  // 失敗をログに記録（エラーは無視 — ログ失敗でもリダイレクトは続行）
  await supabase.from('admin_audit_logs').insert({
    action: 'rl_admin_login_fail', target: ip, detail: { kind: 'rate_limit' },
  });

  return Astro.redirect(`/admin/login?error=1&return_to=${encodeURIComponent(postedReturnTo)}`);
}

const errorCode = Astro.url.searchParams.get('error');
const returnTo = sanitizeReturnTo(Astro.url.searchParams.get('return_to'));
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <title>管理画面ログイン</title>
    <meta name="robots" content="noindex,nofollow" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <style>
      *{box-sizing:border-box}html,body{min-height:100%;margin:0}body{display:grid;place-items:center;padding:24px;background:#0e0d0b;color:#ece8e1;font-family:-apple-system,'Noto Sans JP',sans-serif}
      .login{width:min(100%,420px);padding:34px;background:#16140f;border:1px solid rgba(236,232,225,.12)}
      .mark{margin:0 0 22px;color:#c9a962;font:700 11px/1 sans-serif;letter-spacing:.22em}.login h1{margin:0 0 9px;font-size:25px}.lead{margin:0 0 24px;color:#a49e93;font-size:13px;line-height:1.8}
      .error{margin:0 0 18px;padding:11px 13px;border:1px solid rgba(207,154,102,.4);background:rgba(207,154,102,.08);color:#e0ad7a;font-size:12px;line-height:1.7}
      form{display:grid;gap:12px}input{width:100%;min-height:50px;padding:12px 14px;border:1px solid rgba(236,232,225,.14);border-radius:0;background:#0e0d0b;color:#ece8e1;font-size:16px}input:focus{outline:1px solid #c9a962;border-color:#c9a962}
      button{min-height:50px;border:1px solid #c9a962;background:#c9a962;color:#14120d;font-weight:800;font-size:14px;letter-spacing:.08em;cursor:pointer}button:hover{filter:brightness(1.08)}
      .note{margin:18px 0 0;color:#706b63;font-size:11px;line-height:1.7}
    </style>
  </head>
  <body>
    <main class="login">
      <p class="mark">11HOTEL ADMIN</p>
      <h1>管理画面へログイン</h1>
      <p class="lead">管理トークンを入力すると、元の操作画面へ戻ります。</p>
      {errorCode === '2' && <p class="error">試行回数が多すぎます。しばらく後にお試しください。</p>}
      {errorCode === '1' && <p class="error">管理トークンが一致しません。前後の空白や入力内容をご確認ください。</p>}
      <form method="POST">
        <input type="hidden" name="return_to" value={returnTo} />
        <input
          type="password"
          name="token"
          placeholder="管理トークン"
          required
          autocomplete="current-password"
          autofocus
        />
        <button type="submit">ログインして続ける</button>
      </form>
      <p class="note">秘密鍵やウォレットのシードフレーズを入力する画面ではありません。</p>
    </main>
  </body>
</html>
