---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { fetchStayListings, type StayListing } from '@/lib/opensea-stays';
import { getHouseNote } from '@/lib/notahotel-houses';
import { resolveCheckoutMode } from '@/lib/checkout';

Astro.response.headers.set('Cache-Control', 'no-store, private');
Astro.response.headers.set('CDN-Cache-Control', 'no-store');

const { tokenId } = Astro.params;
if (!tokenId) return Astro.redirect('/vip');

const configuredFeeBps = Number(import.meta.env.KEY_SUPPORT_FEE_BPS ?? 500);
const supportFeeBps = Number.isFinite(configuredFeeBps) ? Math.max(0, Math.min(3000, Math.round(configuredFeeBps))) : 500;
const supportFeeRate = supportFeeBps / 10000;
// Minimum per-night sale price. While V2 is live, use KEY_NIGHTLY_FLOOR_ETH (the value pinned
// into the checkout contract) directly for display. When unset (V1), fall back to the business
// decision of 0.5 ETH for display purposes only.
const nightlyFloorEthRaw = String(import.meta.env.KEY_NIGHTLY_FLOOR_ETH ?? '').trim();
const NIGHTLY_FLOOR_ETH = nightlyFloorEthRaw ? Number(nightlyFloorEthRaw) : 0.5;
const totalEthOf = (l: StayListing): number | null => {
  const p = Number(l.price);
  if (!Number.isFinite(p) || p <= 0) return null;
  const standardTotal = p * (1 + supportFeeRate);
  const floorTotal = NIGHTLY_FLOOR_ETH * (l.nights && l.nights > 0 ? l.nights : 1);
  return Math.round(Math.max(standardTotal, floorTotal) * 10000) / 10000;
};

const apiKey = import.meta.env.OPENSEA_API_KEY;
let listing: StayListing | null = null;
let floorPrice: number | null = null;
if (apiKey) {
  try {
    const payload = await fetchStayListings(apiKey);
    listing = payload.listings.find((l) => l.tokenId === tokenId) ?? null;
    const totals = payload.listings.map((l) => totalEthOf(l)).filter((n): n is number => n != null);
    floorPrice = totals.length ? Math.min(...totals) : null;
  } catch (e) {
    console.error('[stay/[tokenId]] fetch failed:', e instanceof Error ? e.message : e);
  }
}
if (!listing) return Astro.redirect('/vip');

const listingPrice = Number(listing.price);
const supportTotalEth = totalEthOf(listing);
// When the floor applies, 11hotel's actual handling margin (the difference) is larger than the flat rate.
const supportFeeEth = supportTotalEth == null || !Number.isFinite(listingPrice) ? null : supportTotalEth - listingPrice;
// Fact-based "lowest price" display only (no appreciation/resale/investment framing). Compare on
// the handling-inclusive total, not the raw listing price.
const isFloor = floorPrice != null && supportTotalEth != null && supportTotalEth === floorPrice;
const eth = (n: number | null) => n == null ? '—' : (Math.round(n * 10000) / 10000).toString();

// Site-side purchase (same 11hotel checkout contract and safety checks as /vip) completes on this page too.
const configuredCheckout = String(import.meta.env.KEY_CHECKOUT_CONTRACT ?? '').trim();
const checkoutReady = configuredCheckout
  ? (await resolveCheckoutMode(configuredCheckout, supportFeeBps, nightlyFloorEthRaw)).ready
  : false;
const NEAR_CHECKIN_DAYS = 3;
const daysUntilCheckin = (() => {
  if (!listing.checkIn) return null;
  const target = new Date(`${listing.checkIn}T00:00:00+09:00`).getTime();
  if (!Number.isFinite(target)) return null;
  return Math.ceil((target - Date.now()) / 86_400_000);
})();
const isNearCheckin = daysUntilCheckin != null && daysUntilCheckin >= 0 && daysUntilCheckin <= NEAR_CHECKIN_DAYS;

const houseTitle = listing.house || listing.name || `THE KEY #${listing.tokenId}`;
const placeText = [listing.prefecture, listing.place].filter(Boolean).filter((v, i, a) => a.indexOf(v) === i).join(' — ');
const nightsText = listing.nights ? `${listing.nights} night${listing.nights === 1 ? '' : 's'}` : '—';
const property = listing.property;
const houseNote = getHouseNote(property, houseTitle);
const keyImageUrl = listing.keyImageUrl || (property?.imageUrl && listing.imageUrl !== property.imageUrl ? listing.imageUrl : null);
const mapUrl = property
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(property.address ?? property.title)}`
  : null;
const displayImageUrl = property?.imageUrl || listing.imageUrl || keyImageUrl;
const displayFallback = keyImageUrl && displayImageUrl !== keyImageUrl
  ? `this.onerror=null;this.src='${keyImageUrl}';this.classList.add('is-key-fallback');`
  : 'this.remove();';
---

<BaseLayout
  title={`${houseTitle} — THE KEY #${listing.tokenId}`}
  description={`${placeText ? placeText + ' · ' : ''}${listing.checkInLabel} / ${nightsText} · ${listing.price} ${listing.currency}. Ask 11hotel about this listed NOT A HOTEL stay key.`}
>
  <div class="sd2" data-checkout={configuredCheckout} data-checkout-ready={checkoutReady ? '1' : ''} data-lang="en">
    <header class="sd2-nav">
      <a class="sd2-logo" href="/" aria-label="11hotel home">
        <span>いい</span>
        <i>hotel</i>
      </a>
      <nav class="sd2-nav-links">
        <a href="/vip">Market</a>
      </nav>
    </header>
    <div class="sd2-back"><a href="/vip">← Back to Market</a></div>

    <section class="sd2-hero">
      <div class="sd2-media">
        {displayImageUrl
          ? <img class="sd2-photo" src={displayImageUrl} alt={houseTitle} width="1200" height="630" loading="eager" decoding="async" onerror={displayFallback} />
          : <span class="sd2-media-ph">THE KEY</span>}
        <span class="sd2-tag">{isFloor ? 'Best price' : 'On sale'}</span>
        {property?.imageUrl && keyImageUrl && (
          <img class="sd2-key" src={keyImageUrl} alt="THE KEY NFT" loading="lazy" decoding="async" />
        )}
        {property?.imageUrl && (
          <a class="sd2-credit" href={property.officialUrl} target="_blank" rel="noopener noreferrer">Photo: NOT A HOTEL official ↗</a>
        )}
      </div>

      <div class="sd2-info">
        {placeText && <p class="sd2-place">{placeText}</p>}
        <h1 class="sd2-house">{houseTitle}</h1>

        <div class="sd2-price">
          <em>{eth(supportTotalEth)}</em><span>{listing.currency}</span>
          <i>11hotel price · incl. 5% handling</i>
        </div>

        <dl class="sd2-facts">
          <div><dt>Check-in</dt><dd>{listing.checkInLabel}</dd></div>
          <div><dt>Nights</dt><dd>{nightsText}</dd></div>
          {listing.prefecture && <div><dt>Prefecture</dt><dd>{listing.prefecture}</dd></div>}
          {listing.place && <div><dt>Place</dt><dd>{listing.place}</dd></div>}
          <div><dt>Token ID</dt><dd>#{listing.tokenId}</dd></div>
          {floorPrice != null && (
            <div><dt>Current lowest (incl. handling)</dt><dd>{floorPrice} {listing.currency}{isFloor ? ' · lowest right now' : ''}</dd></div>
          )}
        </dl>

        {isNearCheckin && (
          <p class="sd2-near-checkin"><strong>Last-minute</strong> Check-in in {Math.max(daysUntilCheckin ?? 0, 0)} day{Math.max(daysUntilCheckin ?? 0, 0) === 1 ? '' : 's'}. After purchase you must receive the NFT, activate it in the official app, and confirm terms yourself. Purchases cannot be cancelled or refunded. If unsure, consider "Ask before buying" instead.</p>
        )}
        <div class="sd2-ctas">
          {configuredCheckout && checkoutReady && (
            <button type="button" class="sd2-cta sd2-cta--primary sd2-buy" data-order={listing.orderHash ?? ''} data-token={listing.tokenId}
              data-house-name={houseTitle} data-checkin-label={listing.checkInLabel} data-nights-label={nightsText}>
              Buy from 11hotel · {eth(supportTotalEth)} ETH
            </button>
          )}
          <a class={`sd2-cta ${configuredCheckout && checkoutReady ? '' : 'sd2-cta--primary'}`} href="#sdInquiry" id="sdToInquiry">Ask before buying</a>
        </div>
        <p class="sd2-buy-status" id="sdBuyStatus" hidden></p>
        <p class="sd2-cta-note">
          The displayed price includes 11hotel's 5% handling margin (may include the 0.5 ETH per-night minimum sale price). Sending an inquiry alone is never charged.
          Payment and NFT transfer happen from the buyer's own wallet; 11hotel never holds the NFT or funds.
          See our <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a> for details.
        </p>
      </div>
    </section>

    {property && (
      <section class="sd2-guide" id="houseGuide">
        <div class="sd2-guide-head">
          <p class="sd2-eyebrow">House Guide</p>
          <h2>{property.title}</h2>
          <p>{property.area} / {property.shortLabel}</p>
        </div>

        <div class="sd2-guide-grid">
          <article class="sd2-guide-main">
            <h3>About this place</h3>
            <p>{property.summary}</p>
            {houseNote && <p class="sd2-house-note">{houseNote}</p>}
          </article>
          <article>
            <h3>Design</h3>
            <p>{property.design}</p>
          </article>
          <article>
            <h3>How to spend your stay</h3>
            <p>{property.stay}</p>
          </article>
          <article>
            <h3>Dining</h3>
            <p>{property.dining}</p>
          </article>
        </div>

        <div class="sd2-guide-bottom">
          <div>
            <span class="sd2-guide-label">Highlights</span>
            <div class="sd2-guide-tags">
              {property.highlights.map((item) => <span>{item}</span>)}
            </div>
          </div>
          <div>
            <span class="sd2-guide-label">Best for</span>
            <div class="sd2-guide-tags">
              {property.bestFor.map((item) => <span>{item}</span>)}
            </div>
          </div>
          <a class="sd2-guide-official" href={property.officialUrl} target="_blank" rel="noopener noreferrer">
            View on official site ↗
          </a>
        </div>
      </section>
    )}

    {property && (
      <section class="sd2-access">
        <div class="sd2-guide-head">
          <p class="sd2-eyebrow">Access</p>
          <h2>Access</h2>
          <p>{property.area}</p>
        </div>
        <div class="sd2-access-body">
          {property.address && (
            <dl class="sd2-access-facts">
              <div><dt>Address</dt><dd>{property.address}</dd></div>
            </dl>
          )}
          <p class="sd2-access-text">{property.access}</p>
          <div class="sd2-access-links">
            {mapUrl && <a href={mapUrl} target="_blank" rel="noopener noreferrer">View on Google Maps ↗</a>}
            <a href={property.officialUrl} target="_blank" rel="noopener noreferrer">Official access info ↗</a>
          </div>
        </div>
      </section>
    )}

    <!-- Stay procedure (purchase to stay) -->
    <section class="sd2-procedure" id="sdProcedure">
      <div class="sd2-guide-head">
        <p class="sd2-eyebrow">Stay Procedure</p>
        <h2>From purchase to stay</h2>
        <p>Purchase → Activate → Stay</p>
      </div>
      <ol class="sd2-proc-steps">
        <li>
          <span class="sd2-proc-n">01</span>
          <h3>Buy the stay key</h3>
          <p>Confirm the 11hotel price and sign once with your own wallet. Payment and delivery of the stay key (THE KEY) complete in the same transaction.</p>
        </li>
        <li>
          <span class="sd2-proc-n">02</span>
          <h3>Confirm the NFT arrives</h3>
          <p>Usually within minutes. Track the transaction status via the Etherscan link.</p>
        </li>
        <li>
          <span class="sd2-proc-n">03</span>
          <h3>Activate in the NOT A HOTEL app</h3>
          <p>Connect your wallet in the official app and complete activation there. Follow NOT A HOTEL's own guidance and confirmation for terms, reservation status, guest registration, and check-in.</p>
        </li>
        <li>
          <span class="sd2-proc-n">04</span>
          <h3>On the day</h3>
          <p>Check-in/out times, capacity, and amenities differ per HOUSE. Check the official app and site for the latest information before your stay.</p>
        </li>
      </ol>
      <p class="sd2-proc-note">
        Confirming the stay, guest registration, and check-in all happen in the NOT A HOTEL official app. 11hotel is not in a position to confirm reservations;
        we support you through purchase and activation. If anything is unclear along the way, select "Stay procedure support" in the form below and send us a message.
      </p>
      <a class="sd2-proc-cta" href="#sdInquiry" data-topic="procedure">Ask for stay procedure support</a>
    </section>

    <!-- Inquiry (always visible, primary path) -->
    <section class="sd2-inquiry" id="sdInquiry">
      <div class="sd2-inq-head">
        <p class="sd2-eyebrow">Inquiry</p>
        <h2 class="sd2-inq-title">Questions about<br />this one?</h2>
        <p class="sd2-inq-lead">
          This form is for this stay key (Token ID #{listing.tokenId}). Use it before you buy, or afterward for help with the stay procedure and KEY activation.
          Name, email, and preferred contact method are all that's required — desired price and wallet address are optional.
        </p>
      </div>

      <form
        id="sdForm" class="sd2-form"
        data-token={listing.tokenId} data-order={listing.orderHash ?? ''} data-price={listing.price ?? ''}
        data-house={houseTitle} data-prefecture={listing.prefecture ?? ''} data-place={listing.place ?? ''}
        data-checkin={listing.checkIn ?? ''} data-nights={listing.nights ?? ''}
        data-support-fee-bps={supportFeeBps} data-support-fee-eth={eth(supportFeeEth)} data-support-total-eth={eth(supportTotalEth)}
      >
        <div class="sd2-target">
          <span class="sd2-target-label">Asking about</span>
          <span class="sd2-target-val">{houseTitle} <i>/ #{listing.tokenId}</i></span>
        </div>

        <div class="sd2-grid">
          <label class="sd2-f"><span>Topic <b>*</b></span>
            <select name="topic" id="sdTopic" required>
              <option value="purchase">Purchase inquiry</option>
              <option value="procedure">Stay procedure / KEY activation support</option>
              <option value="other">Other</option>
            </select>
          </label>
          <label class="sd2-f"><span>Name</span><input name="name" autocomplete="name" placeholder="Name" /></label>
          <label class="sd2-f"><span>Email <b>*</b></span><input name="email" type="email" required autocomplete="email" placeholder="mail@example.com" /></label>
          <label class="sd2-f"><span>Preferred contact <b>*</b></span>
            <select name="contact_method" required>
              <option value="email">Email</option><option value="line">LINE</option>
              <option value="whatsapp">WhatsApp</option><option value="phone">Phone</option>
              <option value="instagram">Instagram</option><option value="other">Other</option>
            </select>
          </label>
          <label class="sd2-f"><span>Contact handle (optional)</span><input name="contact_handle" placeholder="@account / phone number" /></label>
          <label class="sd2-f"><span>Desired price, ETH (optional)</span><input name="desired_price_eth" type="number" step="0.0001" min="0" inputmode="decimal" placeholder="e.g. 1.2" /></label>
          <label class="sd2-f"><span>Purpose (optional)</span><input name="purpose" placeholder="Anniversary / family trip / business" /></label>
          <label class="sd2-f sd2-f--wallet"><span>Wallet (optional)</span>
            <span class="sd2-wallet-row">
              <input name="wallet_address" id="sdWalletField" placeholder="0x…" />
              <button type="button" id="sdWallet">Connect MetaMask</button>
            </span>
          </label>
        </div>
        <label class="sd2-f sd2-f--full"><span>Message (optional)</span><textarea name="message" rows="4" placeholder="Any conditions or questions"></textarea></label>
        <label class="sd2-consent">
          <input type="checkbox" name="consent" required />
          <span>I agree that my input will be used by 11hotel to handle this inquiry, connect with the seller if needed, and follow up on progress. 11hotel does not hold funds or the NFT, and does not guarantee price, authenticity, stay-key validity, or availability.</span>
        </label>
        <div class="sd2-submit-row">
          <button type="submit" class="sd2-submit" id="sdSubmit">Send inquiry</button>
          <p class="sd2-form-msg" id="sdMsg" aria-live="polite"></p>
        </div>
      </form>
    </section>

    <section class="sd2-legal">
      <p>
        11hotel is not the seller. We organize public listing information to support your purchase.
        We do not guarantee price, NFT authenticity, stay-key validity, or availability, and we never hold the NFT or funds. Payment and NFT transfer happen from the buyer's own wallet.
        Always confirm details on NOT A HOTEL's official site before you buy.
        Statements about the NFT/stay right, referral fees, contracts, and tax/legal standing assume professional review.
      </p>
    </section>
  </div>

  {configuredCheckout && checkoutReady ? (
    <button type="button" class="sd2-sticky sd2-buy" id="sdSticky" data-order={listing.orderHash ?? ''} data-token={listing.tokenId}
              data-house-name={houseTitle} data-checkin-label={listing.checkInLabel} data-nights-label={nightsText} aria-hidden="true">
      Buy from 11hotel · {eth(supportTotalEth)} ETH
    </button>
  ) : (
    <a class="sd2-sticky" id="sdSticky" href="#sdInquiry" aria-hidden="true">Ask before buying</a>
  )}

  <!-- Confirm-before-sign dialog (same safety checks as /vip) -->
  <div class="sd2-modal" id="sdModal" hidden>
    <div class="sd2-modal-mask" id="sdModalMask"></div>
    <div class="sd2-modal-box" role="dialog" aria-modal="true" aria-labelledby="sdmTitle">
      <h3 class="sd2-modal-title" id="sdmTitle">Confirm your purchase</h3>
      <p class="sd2-modal-name" id="sdmName"></p>
      <dl class="sd2-modal-list">
        <div><dt>Check-in date</dt><dd id="sdmDate"></dd></div>
        <div><dt>Nights</dt><dd id="sdmNights"></dd></div>
        <div><dt>Original listing price</dt><dd id="sdmPrice"></dd></div>
        <div><dt id="sdmFeeLabel"></dt><dd id="sdmFee"></dd></div>
        <div><dt>Total payment (gas separate)</dt><dd class="sd2-modal-total" id="sdmTotal"></dd></div>
        <div><dt>Destination contract</dt><dd id="sdmTo"></dd></div>
      </dl>
      <p class="sd2-modal-note">Gas is charged separately. Acquisition, delivery to you, and the 11hotel handling payment execute in one transaction; if any step fails, the entire transaction reverts. Transactions cannot be cancelled once sent.</p>
      <p class="sd2-modal-note sd2-modal-note--terms">Capacity, amenities, check-in/out times, and terms differ per HOUSE. Review the official page before you sign. {property && <a href={property.officialUrl} target="_blank" rel="noopener noreferrer">Check official page ↗</a>}</p>
      {isNearCheckin && <p class="sd2-modal-note sd2-near-checkin" id="sdmNearCheckin">Last-minute: check-in in {Math.max(daysUntilCheckin ?? 0, 0)} day{Math.max(daysUntilCheckin ?? 0, 0) === 1 ? '' : 's'}. After purchase you must receive the NFT, activate it in the official app, and confirm terms yourself. Purchases cannot be cancelled or refunded.</p>}
      <div class="sd2-modal-actions">
        <button type="button" class="sd2-modal-cancel" id="sdmCancel">Cancel</button>
        <button type="button" class="sd2-modal-confirm" id="sdmConfirm">Sign in wallet</button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
import { EthereumProvider } from '@walletconnect/ethereum-provider';

function __sdInit() {
  window.__sdAbort?.abort();
  const ctrl = new AbortController();
  window.__sdAbort = ctrl;
  const { signal } = ctrl;

  const params = new URLSearchParams(location.search);
  // Use the first-touch attribution saved on landing (BaseLayout's __attr) when the URL has no utm params
  const attr = window.__attr?.() || {};
  const source = params.get('utm_source') || params.get('source') || attr.utm_source || 'direct';
  const campaign = params.get('utm_campaign') || params.get('campaign') || attr.utm_campaign || null;

  // MetaMask (read-only, for the inquiry form)
  const walletField = document.getElementById('sdWalletField');
  function setWallet(addr) {
    const btn = document.getElementById('sdWallet');
    if (btn) { btn.textContent = addr.slice(0, 6) + '…' + addr.slice(-4); btn.classList.add('connected'); }
    if (walletField) walletField.value = addr;
  }
  document.getElementById('sdWallet')?.addEventListener('click', async () => {
    const btn = document.getElementById('sdWallet');
    const provider = pickEthProvider();
    if (!provider) { if (btn) btn.textContent = 'MetaMask not found'; return; }
    try { const a = await provider.request({ method: 'eth_requestAccounts' }); if (a && a[0]) { window.__stayWallet = a[0]; setWallet(a[0]); } }
    catch (_e) {}
  }, { signal });
  if (window.__stayWallet) setWallet(window.__stayWallet);

  // "Stay procedure support" CTA → preselect the inquiry topic and scroll to the form
  document.querySelectorAll('[data-topic]').forEach((el) => {
    el.addEventListener('click', () => {
      const sel = document.getElementById('sdTopic');
      if (sel) sel.value = el.dataset.topic || 'purchase';
    }, { signal });
  });

  // sticky
  const sticky = document.getElementById('sdSticky');
  const inquiry = document.getElementById('sdInquiry');
  if (sticky && inquiry) {
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => { sticky.classList.toggle('show', !e.isIntersecting && window.scrollY > 400); });
    }, { threshold: 0.08 });
    io.observe(inquiry);
    signal.addEventListener('abort', () => io.disconnect());
  }

  // submit
  const form = document.getElementById('sdForm');
  const msg = document.getElementById('sdMsg');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submit = document.getElementById('sdSubmit');
    const fd = new FormData(form);
    if (submit) submit.disabled = true;
    if (msg) { msg.textContent = 'Sending…'; msg.className = 'sd2-form-msg'; }
    try {
      const res = await fetch('/api/stays/inquiry', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          token_id: form.dataset.token, order_hash: form.dataset.order || null,
          display_price_eth: form.dataset.price ? Number(form.dataset.price) : null,
          house: form.dataset.house || null, prefecture: form.dataset.prefecture || null,
          place: form.dataset.place || null, checkin_date: form.dataset.checkin || null,
          nights: form.dataset.nights ? Number(form.dataset.nights) : null,
          desired_price_eth: fd.get('desired_price_eth') ? Number(fd.get('desired_price_eth')) : null,
          name: fd.get('name')?.toString() || null, email: fd.get('email')?.toString() || '',
          contact_method: fd.get('contact_method')?.toString() || '',
          contact_handle: fd.get('contact_handle')?.toString() || null,
          purpose: fd.get('purpose')?.toString() || null,
          message: (() => {
            const topicLabel = { purchase: 'Purchase inquiry', procedure: 'Stay procedure / KEY activation support', other: 'Other' }[fd.get('topic')?.toString() || 'purchase'] || 'Purchase inquiry';
            const m = fd.get('message')?.toString() || '';
            return `[${topicLabel}]${m ? '\n' + m : ''}`;
          })(),
          wallet_address: fd.get('wallet_address')?.toString() || window.__stayWallet || null,
          support_fee_bps: Number(form.dataset.supportFeeBps || 0),
          support_fee_eth: Number(form.dataset.supportFeeEth || 0),
          support_total_eth: Number(form.dataset.supportTotalEth || 0),
          consent: fd.get('consent') === 'on', source, campaign,
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Could not send your message');
      if (typeof window.gtag === 'function') window.gtag('event', 'stay_inquiry_submit', { token_id: form.dataset.token, source, campaign });
      form.reset();
      if (msg) { msg.textContent = "Sent. 11hotel will get back to you shortly."; msg.className = 'sd2-form-msg is-ok'; }
    } catch (err) {
      if (msg) { msg.textContent = err.message || 'Could not send your message'; msg.className = 'sd2-form-msg is-err'; }
    } finally { if (submit) submit.disabled = false; }
  }, { signal });

  // ── On-site purchase (same 11hotel checkout contract and safety checks as /vip) ──
  const sd2Root = document.querySelector('.sd2');
  const configuredCheckout = (sd2Root?.dataset.checkout || '').toLowerCase();
  const buyStatus = document.getElementById('sdBuyStatus');
  let buying = false;
  const showBuyStatus = (html) => { if (buyStatus) { buyStatus.hidden = false; buyStatus.innerHTML = html; } };
  const esc2 = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
  const weiToEth = (wei) => {
    try {
      const w = BigInt(wei);
      const whole = w / 10n ** 18n;
      const frac = ((w % 10n ** 18n) * 10000n / 10n ** 18n).toString().padStart(4, '0').replace(/0+$/, '');
      return frac ? `${whole}.${frac}` : whole.toString();
    } catch { return '—'; }
  };
  const fmtN = (n) => n == null || !isFinite(n) ? '—' : (Math.round(n * 1000) / 1000).toString();

  // EIP-6963: reliably pick MetaMask even when multiple wallet extensions are installed
  const announced = new Map();
  window.addEventListener('eip6963:announceProvider', (e) => {
    if (e?.detail?.info?.uuid) announced.set(e.detail.info.uuid, e.detail);
  }, { signal });
  window.dispatchEvent(new Event('eip6963:requestProvider'));
  function pickEthProvider() {
    for (const a of announced.values()) if (a.info.rdns === 'io.metamask') return a.provider;
    const injected = window.ethereum;
    if (injected?.providers?.length) return injected.providers.find((p) => p.isMetaMask) ?? injected.providers[0];
    return injected ?? null;
  }
  function withTimeout(p, ms) {
    return new Promise((resolve, reject) => {
      const t = setTimeout(() => reject(Object.assign(new Error('wallet_timeout'), { code: 'TIMEOUT' })), ms);
      p.then((v) => { clearTimeout(t); resolve(v); }, (e) => { clearTimeout(t); reject(e); });
    });
  }

  // WalletConnect fallback for mobile browsers without an injected wallet (QR / deep-link, no
  // need to leave this tab for the whole session — only for the connect approval step).
  let wcProvider = null;
  async function connectViaWalletConnect() {
    const projectId = import.meta.env.PUBLIC_WALLETCONNECT_PROJECT_ID;
    if (!projectId) return null;
    if (!wcProvider) {
      wcProvider = await EthereumProvider.init({
        projectId,
        chains: [1],
        showQrModal: true,
        metadata: {
          name: '11hotel',
          description: 'THE KEY — buy a NOT A HOTEL stay key with one signature',
          url: 'https://11hotel.vip',
          icons: ['https://11hotel.vip/favicon.svg'],
        },
      });
    }
    await withTimeout(wcProvider.connect(), 180000); // generous window for QR scan + wallet approval
    const account = wcProvider.accounts?.[0] ?? '';
    if (!account) throw Object.assign(new Error('no account'), { code: 4001 });
    return { provider: wcProvider, account };
  }

  async function connectBuyWallet() {
    const injected = pickEthProvider();
    if (injected) {
      const accounts = await withTimeout(injected.request({ method: 'eth_requestAccounts' }), 25000);
      const account = accounts?.[0] ?? '';
      if (!account) throw Object.assign(new Error('no account'), { code: 4001 });
      return { provider: injected, account };
    }
    const viaWc = await connectViaWalletConnect();
    if (viaWc) return viaWc;
    const dapp = `metamask.app.link/dapp/${location.host}${location.pathname}${location.search}`;
    throw Object.assign(new Error('no_wallet'), { code: 'NO_WALLET', dappUrl: `https://${dapp}` });
  }

  // Confirm-before-sign dialog
  const sdModal = document.getElementById('sdModal');
  function confirmSdPurchase(info) {
    document.getElementById('sdmName').textContent = info.name;
    document.getElementById('sdmDate').textContent = info.date;
    document.getElementById('sdmNights').textContent = info.nights;
    document.getElementById('sdmPrice').textContent = `${info.priceEth} ETH`;
    document.getElementById('sdmFeeLabel').textContent = `11hotel handling fee (${info.feePct}%)`;
    document.getElementById('sdmFee').textContent = `${info.feeEth} ETH`;
    document.getElementById('sdmTotal').textContent = `${info.totalEth} ETH`;
    document.getElementById('sdmTo').textContent = info.toLabel;
    sdModal.hidden = false;
    document.body.style.overflow = 'hidden';
    return new Promise((resolve) => {
      const confirmBtn = document.getElementById('sdmConfirm');
      const cancelBtn = document.getElementById('sdmCancel');
      const maskEl = document.getElementById('sdModalMask');
      const done = (ok) => {
        sdModal.hidden = true;
        document.body.style.overflow = '';
        confirmBtn.removeEventListener('click', onOk);
        cancelBtn.removeEventListener('click', onNg);
        maskEl.removeEventListener('click', onNg);
        resolve(ok);
      };
      const onOk = () => done(true);
      const onNg = () => done(false);
      confirmBtn.addEventListener('click', onOk);
      cancelBtn.addEventListener('click', onNg);
      maskEl.addEventListener('click', onNg);
    });
  }

  // Buy button (both the main CTA and the sticky one)
  document.querySelectorAll('.sd2-buy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (buying) return;
      const tokenId = btn.dataset.token;
      const orderHash = btn.dataset.order;
      buying = true;
      document.querySelectorAll('.sd2-buy').forEach((b) => { b.disabled = true; });
      if (typeof window.gtag === 'function') window.gtag('event', 'key_buy_click', { token_id: tokenId });
      try {
        showBuyStatus('Connecting wallet…');
        let provider; let from;
        try {
          ({ provider, account: from } = await connectBuyWallet());
        } catch (ce) {
          if (ce?.code === 'NO_WALLET') showBuyStatus(`No wallet found. On mobile, open this page inside the MetaMask app browser — <a href="${esc2(ce.dappUrl)}" rel="noopener noreferrer">Open in MetaMask ↗</a>`);
          else if (ce?.code === 'TIMEOUT') showBuyStatus('Connection timed out. Please try again');
          else if (ce?.code === -32002) showBuyStatus('MetaMask has a pending connection request. Open it to confirm');
          else if (ce?.code === 4001) showBuyStatus('Cancelled');
          else showBuyStatus('Something went wrong. Please try again');
          return;
        }

        const chainId = await provider.request({ method: 'eth_chainId' });
        if (chainId !== '0x1') {
          try { await provider.request({ method: 'wallet_switchEthereumChain', params: [{ chainId: '0x1' }] }); }
          catch { showBuyStatus('Please switch to Ethereum mainnet'); return; }
        }

        showBuyStatus('Fetching transaction data…');
        const res = await fetch('/api/vip/fulfill', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderHash, fulfiller: from }),
        });
        const fd = await res.json().catch(() => ({}));
        if (res.status === 404 || res.status === 409) { showBuyStatus('This listing was filled or withdrawn'); return; }
        if (res.status === 429 || res.status === 502 || res.status === 503) { showBuyStatus('Busy right now — please try again shortly'); return; }
        if (!res.ok || !fd.ok || !fd.tx) { showBuyStatus('Something went wrong. Please try again'); return; }

        const toLower = String(fd.tx.to || '').toLowerCase();
        if (!configuredCheckout || toLower !== configuredCheckout) { showBuyStatus('Aborted because the destination could not be verified'); return; }
        if (!fd.priceWei || !fd.feeWei || !fd.totalWei || BigInt(fd.tx.value) !== BigInt(fd.totalWei)
          || BigInt(fd.totalWei) !== BigInt(fd.priceWei) + BigInt(fd.feeWei)) { showBuyStatus('Aborted for safety: amount does not match the listing price'); return; }

        const proceed = await confirmSdPurchase({
          name: `${btn.dataset.houseName || ''} — ${btn.dataset.checkinLabel || ''}`,
          date: btn.dataset.checkinLabel || '—',
          nights: btn.dataset.nightsLabel || '—',
          priceEth: weiToEth(fd.priceWei),
          feeEth: weiToEth(fd.feeWei),
          feePct: fmtN((fd.feeBps ?? 500) / 100),
          totalEth: weiToEth(fd.tx.value),
          toLabel: `11hotel verified checkout（${fd.tx.to.slice(0, 8)}…${fd.tx.to.slice(-6)}）`,
        });
        if (!proceed) { showBuyStatus('Cancelled'); return; }

        const value = '0x' + BigInt(fd.tx.value).toString(16);
        try {
          await provider.request({ method: 'eth_estimateGas', params: [{ from, to: fd.tx.to, value, data: fd.tx.data }] });
        } catch (estimateError) {
          const m = String(estimateError?.message ?? '').toLowerCase();
          if (m.includes('insufficient funds') || m.includes('insufficient balance')) showBuyStatus('Insufficient ETH balance. Make sure you have enough for the displayed price plus gas');
          else showBuyStatus('This transaction cannot execute right now. The listing may be sold, repriced, or the network may be unavailable');
          return;
        }

        showBuyStatus('Review and sign in your wallet');
        const txHash = await provider.request({ method: 'eth_sendTransaction', params: [{ from, to: fd.tx.to, value, data: fd.tx.data }] });
        if (typeof window.gtag === 'function') window.gtag('event', 'key_buy_submitted', { token_id: tokenId, tx: txHash });
        showBuyStatus(`Submitted. The NFT will arrive in your wallet shortly — <a href="https://etherscan.io/tx/${esc2(txHash)}" target="_blank" rel="noopener noreferrer">View on Etherscan ↗</a>`);

        const logged = await fetch('/api/vip/purchase-log', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            token_id: tokenId, order_hash: orderHash, tx_hash: txHash,
            price_eth: fd.priceWei ? Number(weiToEth(fd.priceWei)) : null, wallet_address: from,
            fee_eth: fd.feeWei ? Number(weiToEth(fd.feeWei)) : null,
            total_eth: fd.totalWei ? Number(weiToEth(fd.totalWei)) : null,
            fee_bps: fd.feeBps ?? null,
            house: form?.dataset.house || null, prefecture: form?.dataset.prefecture || null,
            place: form?.dataset.place || null, checkin_date: form?.dataset.checkin || null,
            nights: form?.dataset.nights ? Number(form.dataset.nights) : null,
            attribution: window.__attr?.() ?? null,
          }),
        }).then((r) => r.json()).catch(() => null);
        if (logged?.id) {
          (async () => {
            for (let attempt = 0; attempt < 36; attempt++) {
              await new Promise((r) => setTimeout(r, 5000));
              const result = await fetch('/api/vip/purchase-status', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: logged.id, txHash }),
              }).then((r) => r.json()).catch(() => null);
              if (result?.status === 'confirmed') {
                showBuyStatus(`Purchase confirmed. The stay key is now in your wallet — <a href="https://etherscan.io/tx/${esc2(txHash)}" target="_blank" rel="noopener noreferrer">View on Etherscan ↗</a>`);
                return;
              }
              if (result?.status === 'failed') {
                showBuyStatus(`The transaction did not complete. No funds moved — <a href="https://etherscan.io/tx/${esc2(txHash)}" target="_blank" rel="noopener noreferrer">View on Etherscan ↗</a>`);
                return;
              }
            }
          })();
        }
      } catch (e) {
        if (e?.code === 4001) showBuyStatus('Cancelled');
        else {
          const m = String(e?.message ?? '').toLowerCase();
          if (m.includes('insufficient funds') || m.includes('insufficient balance')) showBuyStatus('Insufficient ETH balance. Make sure you have enough for the displayed price plus gas');
          else if (m.includes('locked') || e?.code === -32002) showBuyStatus('Unlock your wallet and try again');
          else showBuyStatus('Something went wrong. Please try again');
        }
      } finally {
        buying = false;
        document.querySelectorAll('.sd2-buy').forEach((b) => { b.disabled = false; });
      }
    }, { signal });
  });
}
if (window.__sdPageLoad) document.removeEventListener('astro:page-load', window.__sdPageLoad);
window.__sdPageLoad = __sdInit;
document.addEventListener('astro:page-load', window.__sdPageLoad);
</script>

