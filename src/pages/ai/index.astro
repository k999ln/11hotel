---
/**
 * Quant Ops Desk — chart-first daily console.
 * Auth: ADMIN_TOKEN cookie. Client talks to /api/ai via bridge.
 */
import QuantDesk from '../../components/ai/QuantDesk.astro';
import '../../styles/ai-desk.css';

const token = Astro.cookies.get('admin_token')?.value;
if (token !== import.meta.env.ADMIN_TOKEN) {
  return Astro.redirect('/admin/login?return_to=/ai');
}
---
<!doctype html>
<html lang="ja" data-api-base="/api/ai" data-remote="true" data-desk-mode="ops">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Quant Desk · 11hotel</title>
  </head>
  <body>
    <QuantDesk />
    <script src="/ai/ai-desk.js" defer></script>
  </body>
</html>
