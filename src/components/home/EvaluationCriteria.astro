---
// HOW TO BUY: 購入の流れ。ゲームのステータス画面ではなく、細い罫線と余白のエディトリアル表現で。
const STEPS: Array<{ no: string; title: string; body: string }> = [
  { no: '01', title: 'Review and sign', body: 'Confirm the 11hotel price (the total including handling), then sign once with your own wallet.' },
  { no: '02', title: 'The NFT arrives in your wallet', body: 'Usually within minutes. Payment and receipt of the stay key complete in the same transaction — if any step fails, the entire transaction is reverted.' },
  { no: '03', title: 'Activate in the official app', body: 'Connect your wallet in the NOT A HOTEL official app to complete activation. Check the official app and site for conditions of use and confirmation status.' },
];
---

<section class="gxe" id="guide">
  <div class="gxe-in">
    <div class="gxe-head gx-reveal">
      <p class="gx-label">HOW TO BUY</p>
      <h2>One signature to buy.</h2>
      <p class="gxe-note">
        Blockchain transactions cannot be cancelled or refunded once sent.
        If anything is unclear, use "Ask before buying" on any listing to reach 11hotel.
      </p>
    </div>
    <ol class="gxe-list">
      {STEPS.map((s, i) => (
        <li class="gx-reveal" data-reveal-delay={String(i * 60)}>
          <span class="gxe-no">{s.no}</span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .gxe { background: var(--gx-bg2); }
  .gxe-in {
    max-width: 1200px; margin: 0 auto;
    padding: clamp(70px, 12vh, 150px) clamp(20px, 3.4vw, 48px);
    display: grid; gap: clamp(30px, 5vw, 70px);
  }
  @media (min-width: 960px) { .gxe-in { grid-template-columns: .9fr 1.1fr; align-items: start; } }
  .gxe-head h2 { font-weight: 700; font-size: clamp(24px, 3vw, 38px); color: var(--gx-txt); margin: 14px 0 16px; }
  .gxe-note { font-size: 13px; line-height: 2.1; color: var(--gx-sub); margin: 0; }
  .gxe-list { list-style: none; margin: 0; padding: 0; }
  .gxe-list li {
    display: grid; grid-template-columns: 64px 1fr; gap: 18px; align-items: start;
    border-top: 1px solid var(--gx-line); padding: 20px 2px;
  }
  .gxe-list li:last-child { border-bottom: 1px solid var(--gx-line); }
  .gxe-no { font-family: var(--gx-en); font-weight: 700; font-size: 22px; color: rgba(255,255,255,.3); line-height: 1.4; }
  .gxe-list h3 { font-weight: 700; font-size: 16px; color: var(--gx-txt); margin: 0 0 8px; }
  .gxe-list p { margin: 0; font-size: 13px; line-height: 2; color: var(--gx-sub); }
</style>
