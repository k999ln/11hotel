---
// DESTINATIONS: 大きな風景（掲載ホテルの写真を流用）で地名を見せる横スクロール。
// ホイールは奪わず、通常のスワイプ/ドラッグ + 前後ボタンで操作する。
export type Destination = {
  key: string;
  label: string;     // TOKYO など
  copy: string;      // 日本語一行コピー
  image: string | null;
  count: number;
  /** 遷移先。エリア一覧ページは未実装のため、当面はそのエリアの最新ホテル詳細へ */
  href: string;
};
const badgeLabel = (d: Destination) => (d.count > 0 ? `${d.count} listed` : 'None listed now');
interface Props { destinations: Destination[] }
const { destinations } = Astro.props;
---

<section class="gxd" id="destinations">
  <div class="gxd-head gx-reveal">
    <p class="gx-label">DESTINATIONS</p>
    <h2>Choose a hotel by place.</h2>
    <span class="gxd-btns">
      <button type="button" id="gxdPrev" aria-label="Scroll to previous destination">←</button>
      <button type="button" id="gxdNext" aria-label="Scroll to next destination">→</button>
    </span>
  </div>
  <div class="gxd-track" id="gxdTrack" tabindex="0" role="group" aria-label="Destination list">
    {destinations.map((d) => (
      <a class:list={['gxd-card', d.count === 0 && 'is-empty']} href={d.href} data-area={d.key}>
        {d.image
          ? <img src={d.image} alt={`Hotel in ${d.label}`} loading="lazy" decoding="async" />
          : <span class="gxd-ph" aria-hidden="true"></span>}
        <span class="gxd-veil" aria-hidden="true"></span>
        <span class:list={['gxd-badge', d.count > 0 && 'is-active']}>{badgeLabel(d)}</span>
        <span class="gxd-body">
          <strong>{d.label}</strong>
          <span>{d.copy}</span>
        </span>
      </a>
    ))}
  </div>
</section>

<script>
  const init = () => {
    const track = document.getElementById('gxdTrack');
    if (!track || track.dataset.ready === 'true') return;
    track.dataset.ready = 'true';
    const step = () => Math.min(track.clientWidth * 0.7, 640);
    document.getElementById('gxdPrev')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    document.getElementById('gxdNext')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .gxd { padding: clamp(60px, 10vh, 130px) 0; }
  .gxd-head {
    max-width: 1440px; margin: 0 auto clamp(26px, 4vh, 44px);
    padding: 0 clamp(20px, 3.4vw, 48px);
    display: flex; align-items: end; gap: 20px; flex-wrap: wrap;
  }
  .gxd-head h2 { font-weight: 700; font-size: clamp(24px, 3vw, 40px); color: var(--gx-txt); margin: 14px 0 0; }
  .gxd-btns { margin-left: auto; display: inline-flex; gap: 10px; }
  .gxd-btns button {
    width: 46px; height: 46px; border-radius: 999px; cursor: pointer;
    background: transparent; border: 1px solid var(--gx-line); color: var(--gx-txt); font-size: 15px;
    transition: border-color .3s, background .3s;
  }
  .gxd-btns button:hover, .gxd-btns button:focus-visible { border-color: rgba(255,255,255,.55); background: rgba(255,255,255,.06); }

  .gxd-track {
    display: flex; gap: clamp(14px, 1.8vw, 24px);
    overflow-x: auto; scroll-snap-type: x proximity; overscroll-behavior-x: contain;
    padding: 0 clamp(20px, 3.4vw, 48px) 8px; scrollbar-width: none;
  }
  .gxd-track::-webkit-scrollbar { display: none; }
  .gxd-card {
    position: relative; flex: 0 0 auto; width: min(78vw, 560px); aspect-ratio: 16 / 10;
    border-radius: 10px; overflow: hidden; text-decoration: none; background: #111;
    scroll-snap-align: start;
  }
  .gxd-card img, .gxd-ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .gxd-ph { background: #141414; }
  .gxd-card img { transition: transform .8s cubic-bezier(.22, 1, .36, 1); }
  .gxd-card:hover img, .gxd-card:focus-visible img { transform: scale(1.03); }
  .gxd-veil { position: absolute; inset: 0; background: linear-gradient(to top, rgba(8,8,8,.7), rgba(8,8,8,.04) 55%); }
  .gxd-body { position: absolute; left: 22px; bottom: 18px; right: 22px; display: grid; gap: 6px; }
  .gxd-body strong {
    font-family: var(--gx-en); font-weight: 700; text-transform: uppercase;
    font-size: clamp(28px, 3.4vw, 46px); letter-spacing: .01em; color: var(--gx-txt); line-height: 1;
  }
  .gxd-body span { font-size: 12.5px; color: var(--gx-sub); }

  .gxd-badge {
    position: absolute; top: 14px; right: 14px;
    font-family: var(--gx-en); font-size: 10.5px; font-weight: 700; letter-spacing: .1em;
    padding: 5px 10px; border-radius: 999px;
    background: rgba(8,8,8,.55); color: rgba(255,255,255,.68); border: 1px solid rgba(255,255,255,.22);
  }
  .gxd-badge.is-active { color: #fff; background: rgba(20,115,255,.28); border-color: rgba(20,115,255,.6); }

  /* 出品のない拠点は写真を落として弱め、購入可能な拠点と視覚的に差をつける */
  .gxd-card.is-empty img { filter: grayscale(.7) brightness(.62); }
  .gxd-card.is-empty .gxd-body strong { color: rgba(245,245,242,.55); }
  .gxd-card.is-empty .gxd-body span { color: rgba(255,255,255,.4); }
  .gxd-card.is-empty:hover img, .gxd-card.is-empty:focus-visible img { transform: none; }
</style>
