  @media (prefers-reduced-motion: reduce) { .km-ticker-track { animation: none; } .km-dot { animation: none; } .km-flash { animation: none; } }
  .km-tick { display: inline-flex; align-items: center; gap: 9px; font-size: 12px; letter-spacing: .06em; color: var(--muted); font-variant-numeric: tabular-nums; }
  .km-tick i { width: 4px; height: 4px; background: var(--gold); border-radius: 50%; }

  /* LINEUP（NOT A HOTEL式の拠点カード） */
