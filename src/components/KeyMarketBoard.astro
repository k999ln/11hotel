  .km-hero-title { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 500; font-style: italic; font-size: clamp(30px, 5vw, 62px); line-height: 1.18; letter-spacing: 0; color: #fff; margin: 0 0 18px; text-shadow: 0 2px 30px rgba(0,0,0,.5); }
