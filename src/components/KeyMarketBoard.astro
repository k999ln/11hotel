  .km-lineup-head { margin: 0 0 10px; }
  .km-lineup-grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
  @media (min-width: 640px) { .km-lineup-grid { grid-template-columns: repeat(2, 1fr); } }
  .km-lu { position: relative; display: block; padding: 0; margin: 0; border: 1px solid var(--line2); border-radius: 14px; background: #111111; cursor: pointer; text-align: left; overflow: hidden; aspect-ratio: 16 / 10; transition: border-color .25s; }
