  body:has(.km) main { padding-top: 0; }
  body:has(.km) > footer { background: #080808; color: rgba(255,255,255,.62); border-top-color: rgba(255,255,255,.1); }
  body:has(.km) #hd { display: none; }
  .km {
    --bg: #080808; --surface: #111111; --line: rgba(255,255,255,.14); --line2: rgba(255,255,255,.07);
    --txt: #F5F5F2; --muted: rgba(255,255,255,.62); --dim: rgba(255,255,255,.4); --gold: #1473FF; --green: #6fcf97; --amber: #e8965a;
    --ink: #F5F5F2; --accent: #1473FF;
