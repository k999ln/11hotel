  .km-sub { font-size: 14px; line-height: 2; color: var(--muted); margin: 0 0 26px; max-width: 56ch; }

  .km-livebar { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 13px 2px; }
  .km-livebar-note { margin: 8px 2px 0; font-size: 10.5px; color: var(--dim); letter-spacing: .02em; }
