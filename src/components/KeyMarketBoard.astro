  .km-nav { position: sticky; top: 0; z-index: 90; width: 100vw; margin-left: calc(50% - 50vw); background: rgba(10,10,12,.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line2); }
  .km-nav-inner { max-width: 1240px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 44px); min-height: 58px; display: flex; align-items: center; gap: 22px; }
  .km-nav-brand { display: flex; flex-direction: column; gap: 1px; text-decoration: none; color: #fff; font-family: var(--disp); font-weight: 800; font-size: 17px; letter-spacing: .06em; line-height: 1; }
