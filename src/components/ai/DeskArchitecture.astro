---
/** Quant Control · architecture */
---
<section id="architecture" class="view section" data-view="architecture" hidden>
      <div class="section-title">
        <div>
          <p class="section-kicker">GOVERNANCE</p>
          <h2>設計・単一情報源・既知の限界</h2>
        </div>
      </div>
      <div class="grid-2">
        <section class="panel">
          <div class="panel-head"><h3>Single Source of Truth</h3></div>
          <div class="table-wrap">
            <table id="truth-table">
              <thead><tr><th>領域</th><th>保存先</th><th>責任モジュール</th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
        </section>
        <section class="panel limit-panel">
          <div class="panel-head"><h3>既知の限界</h3></div>
          <ul id="limits" class="limit-list"></ul>
        </section>
      </div>
    </section>
